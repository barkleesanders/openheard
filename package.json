{
  "name": "openheard",
  "private": true,
  "description": "Open source feedback board that looks like a 2026 product — board, roadmap, changelog. One Cloudflare Worker + D1, deploys free.",
  "license": "AGPL-3.0",
  "homepage": "https://openheard.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Heilonng23/openheard.git"
  },
  "bugs": {
    "url": "https://github.com/Heilonng23/openheard/issues"
  },
  "keywords": [
    "feedback",
    "feedback-board",
    "roadmap",
    "changelog",
    "canny-alternative",
    "featurebase",
    "self-hosted",
    "cloudflare-workers",
    "d1",
    "tanstack-start",
    "drizzle",
    "better-auth"
  ],
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.6.7",
      "typescript": "^6.0.3",
      "@types/node": "^26.6.5",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "sonner": "^2.0.8",
      "tailwindcss": "^4.3.3",
      "@libsql/client": "0.17.4",
      "libsql": "0.5.29",
      "better-auth": "1.7.1",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types",
    "lint": "node --test scripts/lint-gate.test.mjs scripts/generate-routes.test.mjs && biome check --error-on-warnings",
    "gate:quality": "bun run lint && bun run check-types && bun run --filter web test",
    "dev:web": "bun run --filter web dev:bare",
    "db:generate": "bun run --filter @openheard/db db:generate",
    "deploy": "bun run deploy:instance",
    "destroy": "bun run --filter @openheard/infra destroy",
    "dev:local": "OPENHEARD_LOCAL=1 bun run --filter web dev:bare",
    "db:push:local": "bun run --filter @openheard/db db:push:local",
    "db:seed": "OPENHEARD_LOCAL=1 bun run --filter web seed",
    "demo:reset": "OPENHEARD_LOCAL=1 bun run --filter web demo:reset",
    "gate:auth-security": "vitest run --config packages/auth/vitest.config.ts",
    "gate:dependency-security": "node scripts/dependency-security.test.mjs",
    "gate:public-assets": "node --test scripts/public-assets.test.mjs && node scripts/public-assets.mjs",
    "deploy:instance": "bun run gate:quality && bun run gate:dependency-security && bun run gate:auth-security && bun run test:email-design && node --test scripts/public-assets.test.mjs && node scripts/public-assets.mjs --live-config --check-origin && cd packages/infra && bunx alchemy deploy --stage prod --yes && node ../../scripts/public-assets.mjs --live-config",
    "test:email-design": "vitest run --config packages/auth/vitest.config.ts src/email-design.test.ts src/email-delivery.test.ts && cd apps/web && vitest run src/lib/email.test.ts src/lib/email-test-route.test.ts src/lib/subscriptions.test.ts src/lib/notification-dispatch.test.ts"
  },
  "dependencies": {
    "@openheard/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@libsql/client": "catalog:",
    "@openheard/auth": "workspace:*",
    "@openheard/config": "workspace:*",
    "@openheard/db": "workspace:*",
    "@types/node": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "^0.45.4",
    "oxc-transform-react": "^0.149.0",
    "typescript": "catalog:",
    "vitest": "^4.1.12"
  },
  "packageManager": "bun@1.3.11",
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@prisma/dev": "^0.25.2",
    "esbuild": "^0.28.2"
  },
  "patchedDependencies": {
    "braces@3.0.3": "patches/braces@3.0.3.patch"
  }
}
