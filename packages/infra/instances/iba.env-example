# Instance "iba" of openheard: feedback.improvebayarea.com
# Copy to packages/infra/.env.iba (gitignored), fill BETTER_AUTH_SECRET, then deploy with
#   OPENHEARD_INSTANCE=iba bunx alchemy deploy --stage prod
# See docs/self-host-improve-network.md.

# Stack name becomes openheard-iba; prefixes the Worker, D1 and KV names.
OPENHEARD_INSTANCE=iba

# Cloudflare custom domain attached to the Worker (DNS + certificate managed by Alchemy).
OPENHEARD_DOMAIN=feedback.improvebayarea.com
# Zone id for improvebayarea.com, so Alchemy never has to look the zone up by name.
OPENHEARD_ZONE_ID=ce06a59364532aff60c4de445a4ba519

# Required: 32+ char random string (openssl rand -base64 32). Never commit the real value.
BETTER_AUTH_SECRET=

# Public URL of this instance; must match OPENHEARD_DOMAIN.
BETTER_AUTH_URL=https://feedback.improvebayarea.com

# Blank on purpose: a custom domain resolves to the built-in "default"
# workspace (apps/web/src/lib/session.ts workspaceSlugFromHost).
ROOT_DOMAIN=

# Optional: Google OAuth for "Sign in with Google". Leave blank to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
