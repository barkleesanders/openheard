# Instance "aiva" of openheard: feedback.aivaclaims.com
# Copy to packages/infra/.env.aiva (gitignored), fill BETTER_AUTH_SECRET, then deploy with
#   OPENHEARD_INSTANCE=aiva bunx alchemy deploy --stage prod
# See docs/self-host-improve-network.md.

# Stack name becomes openheard-aiva; prefixes the Worker, D1 and KV names.
OPENHEARD_INSTANCE=aiva

# Cloudflare custom domain attached to the Worker (DNS + certificate managed by Alchemy).
OPENHEARD_DOMAIN=feedback.aivaclaims.com
# Zone id for aivaclaims.com, so Alchemy never has to look the zone up by name.
OPENHEARD_ZONE_ID=1e741eb60017d0c0a9d04e0e2ee100df

# Required: 32+ char random string (openssl rand -base64 32). Never commit the real value.
BETTER_AUTH_SECRET=

# Public URL of this instance; must match OPENHEARD_DOMAIN.
BETTER_AUTH_URL=https://feedback.aivaclaims.com

# Blank on purpose: a custom domain resolves to the built-in "default"
# workspace (apps/web/src/lib/session.ts workspaceSlugFromHost).
ROOT_DOMAIN=

# Auth mail sender. Email Sending is enabled on notifications.<zone> in this account
# (verified `wrangler email sending list` 2026-09-20); an apex/unenabled From fails.
AUTH_EMAIL_FROM=feedback@notifications.aivaclaims.com
AUTH_EMAIL_FROM_NAME=AIVA Claims Feedback

# Optional: Google OAuth for "Sign in with Google". Leave blank to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
