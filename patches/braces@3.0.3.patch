+// Validate iteratively: public walkers also accept ASTs that bypass parse().
+// Follow only child edges; parser ASTs normally contain parent back-references.
+exports.assertDepth = ast => {
+  const pending = [{ node: ast, depth: 0 }];
+  const seen = new WeakMap();
+  while (pending.length) {
+    const { node, depth } = pending.pop();
+    if (!node || typeof node !== 'object' || !Array.isArray(node.nodes)) continue;
+    if (depth > 100) {
+      throw new SyntaxError('Brace nesting exceeds maximum depth (100)');
+    }
+    if (seen.has(node) && seen.get(node) >= depth) continue;
+    seen.set(node, depth);
+    for (const child of node.nodes) pending.push({ node: child, depth: depth + 1 });
+  }
+};
